# Public Expo client configuration. These values are bundled into the app.
EXPO_PUBLIC_CONVEX_URL=
EXPO_PUBLIC_CONVEX_SITE_URL=
EXPO_PUBLIC_WHOP_EMBEDDED_CHAT_CHANNEL_ID=

# Server-only secrets and identifiers. Set these in the Convex deployment;
# never prefix secrets with EXPO_PUBLIC_ or include them in the mobile bundle.
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=
WHOP_ENVIRONMENT=sandbox
WHOP_COMPANY_ID=
WHOP_DEFAULT_PRODUCT_ID=
OPENAI_API_KEY=
GEMINI_API_KEY=
