{
  "expo": {
    "name": "Ante",
    "slug": "ante",
    "scheme": "ante",
    "version": "1.0.0",
    "orientation": "portrait",
    "android": {
      "package": "com.ante.habitpot",
      "permissions": ["android.permission.CAMERA"]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Ante to access your camera to submit habit proof.",
          "recordAudioAndroid": false
        }
      ],
      "expo-web-browser"
    ]
  }
}
