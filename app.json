{
  "expo": {
    "name": "Ante",
    "slug": "ante",
    "scheme": "ante",
    "version": "1.0.0",
    "orientation": "portrait",
    "android": {
      "package": "com.ante.habitpot",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Ante to access your camera to submit habit proof.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Ante to verify your live sidequest walk on the map."
        }
      ],
      "expo-web-browser",
      "expo-font"
    ]
  }
}
